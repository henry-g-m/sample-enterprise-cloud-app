# Environment Configuration
# Copy this file to .env and update values for your environment

# Application
APP_TITLE=Enterprise Demo Cloud App
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=false

# CORS
CORS_ORIGINS=["*"]

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# Observability
ENABLE_APP_INSIGHTS=false
APP_INSIGHTS_CONNECTION_STRING=

# Logging
LOG_LEVEL=INFO
